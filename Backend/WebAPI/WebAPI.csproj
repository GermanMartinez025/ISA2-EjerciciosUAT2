<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>WebAPI</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.3"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0-rc.1.24451.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Controllers\Controllers.csproj" />
      <ProjectReference Include="..\InjectionService\InjectionService.csproj" />
      <ProjectReference Include="..\ModelException\ModelException.csproj" />
      <ProjectReference Include="..\ModelsAPI\ModelsAPI.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="WebAPITests\obj\project.assets.json" />
      <_ContentIncludedByDefault Remove="WebAPITests\obj\project.packagespec.json" />
      <_ContentIncludedByDefault Remove="WebAPITests\obj\WebAPITests.csproj.nuget.dgspec.json" />
    </ItemGroup>

</Project>
